# Generated by websites/scripts/build.mjs — Apache (Hostinger)
# 1. Directory Browsing Protection
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 2. Block Hidden Files & Directories (.git, .env, .DS_Store, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. Block Sensitive & Source File Extensions
<FilesMatch "\.(sh|bash|swift|ts|tsx|py|sql|bak|swp|env|yml|yaml|xcodeproj|xcworkspace|map|md|log|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3b. Block Access to Server Contact Submissions Log
<FilesMatch "^(contact_submissions\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 4. HTTPS Force Redirect & Canonical Host
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 5. Security Headers (Anti-XSS, Anti-Clickjacking, Anti-Sniffing, Strict CSP)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' data:; connect-src 'self' https://api.stripe.com https://r.stripe.com https://m.stripe.network; frame-src https://js.stripe.com https://hooks.stripe.com https://m.stripe.network; frame-ancestors 'self'; form-action 'self' https://checkout.stripe.com mailto:;"

  <FilesMatch "\.(html|json|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

AddType application/x-apple-diskimage .dmg
AddType application/x-msdownload .exe
AddType application/manifest+json .webmanifest
<FilesMatch "\.(dmg|exe|zip)$">
  Header set Content-Disposition "attachment"
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
